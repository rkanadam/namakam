    "timestamp": "11:20",
    "text": " dhesant dhesant de he"
  },
  {
    "offset_sec": 4.0,
    "vid_start_sec": 684.0,
    "timestamp": "11:24",
    "text": " Hon namo bhagavade ruddhraja"
  },
  {
    "offset_sec": 10.0,
    "vid_start_sec": 690.0,
    "timestamp": "11:30",
    "text": " Hon namaaste ruddhra manyabhutod aishavena maha"
  },
  {
    "offset_sec": 15.0,
    "vid_start_sec": 695.0,
    "timestamp": "11:35",
    "text": " Namaste astudhanvan eva hukya buta te na maha"
  },
  {
    "offset_sec": 21.0,
    "vid_start_sec": 701.0,
    "timestamp": "11:41",
    "text": " Yad aishosiva tamaji vambhubate dhanohu"
  },
  {
    "offset_sec": 26.0,
    "vid_start_sec": 706.0,
    "timestamp": "11:46",
    "text": " Hibh\u0101ja dviy\u0101j\u0101tabatad orudhravada dv\u0101ja"
  },
  {
    "offset_sec": 31.0,
    "vid_start_sec": 711.0,
    "timestamp": "11:51",
    "text": " Y\u0101te ruddhrajip\u0101tanur\u0101kho r\u0101p\u0101paka\u015bini"
  },
  {
    "offset_sec": 36.0,
    "vid_start_sec": 716.0,
    "timestamp": "11:56",
    "text": " T\u0101k\u0101nastanubh\u0101chamta maj\u0101kiri chant\u0101phi ca k\u0101chihe"
  },
  {
    "offset_sec": 42.0,
    "vid_start_sec": 722.0,
    "timestamp": "12:02",
    "text": " Y\u0101bi\u015bungiri chant\u0101haste bhi bharyasthabe"
  },
  {
    "offset_sec": 47.0,
    "vid_start_sec": 727.0,
    "timestamp": "12:07",
    "text": " Hibh\u0101ngiri trattankuruma higamsev purushandakate"
  },
  {
    "offset_sec": 53.0,
    "vid_start_sec": 733.0,
    "timestamp": "12:13",
    "text": " Jibh\u0113navachas\u0101t v\u0101giri ch\u0101tch\u0101 vada m\u0101si"
  },
  {
    "offset_sec": 58.0,
    "vid_start_sec": 738.0,
    "timestamp": "12:18",
    "text": " Yat\u0101na sarvabhicj\u0101dha dheksbha gumsumana"
  },
  {
    "offset_sec": 63.0,
    "vid_start_sec": 743.0,
    "timestamp": "12:23",
    "text": " A\u1e63ate hattya bojadadi bhakt\u0101 patamodai viyobhichake"
  },
  {
    "offset_sec": 70.0,
    "vid_start_sec": 750.0,
    "timestamp": "12:30",
    "text": " Ahekashch\u0101 sarv\u0101 andambhajantarv\u0101 ashtaj\u0101tudhanyaha"
  },
  {
    "offset_sec": 78.0,
    "vid_start_sec": 758.0,
    "timestamp": "12:38",
    "text": " A\u1e63auyastamro arona kuta bhabrasumangala"
  },
  {
    "offset_sec": 83.0,
    "vid_start_sec": 763.0,
    "timestamp": "12:43",
    "text": " Y\u0113j\u0113ma gumbhruddhra"
  },
  {
    "offset_sec": 87.0,
    "vid_start_sec": 767.0,
    "timestamp": "12:47",
    "text": " Abhidodikchoshrita s\u0101hasr\u0101javai s\u0101gumhe d\u0101k\u012bbh\u0113"
  },
  {
    "offset_sec": 93.0,
    "vid_start_sec": 773.0,
    "timestamp": "12:53",
    "text": " A\u1e63auyobh\u0101 sarpati ni lakribo vilohit\u0101"
  },
  {
    "offset_sec": 98.0,
    "vid_start_sec": 778.0,
    "timestamp": "12:58",
    "text": " Utainangopa adhrajandhadrajandhud\u0101harjah"
  },
  {
    "offset_sec": 104.0,
    "vid_start_sec": 784.0,
    "timestamp": "13:04",
    "text": " Utainangwisv\u0101 bhuta ni sadhristomrda d\u0101tina"
  },
  {
    "offset_sec": 109.0,
    "vid_start_sec": 789.0,
    "timestamp": "13:09",
    "text": " Namu astunilakriva gaza hasrakha jamidhu\u015behe"
  },
  {
    "offset_sec": 116.0,
    "vid_start_sec": 796.0,
    "timestamp": "13:16",
    "text": " Athode asya satb\u0101nohante yokkarandamahai"
  },
  {
    "offset_sec": 123.0,
    "vid_start_sec": 803.0,
    "timestamp": "13:23",
    "text": " Pramunjadhanva nastvamubh\u0101dor\u0101rtrinjodhyam"
  },
  {
    "offset_sec": 128.0,
    "vid_start_sec": 808.0,
    "timestamp": "13:28",
    "text": " Y\u0101shch\u0101teh\u0101st\u0101 ishav\u0101p\u0101r\u0101t\u0101 bhagabh\u0101p\u0101"
  },
  {
    "offset_sec": 134.0,
    "vid_start_sec": 814.0,
    "timestamp": "13:34",
    "text": " Abh\u0101t\u0101tya dhanosthvagamh\u0101 hasrakha jamidhu\u015behe"
  },
  {
    "offset_sec": 139.0,
    "vid_start_sec": 819.0,
    "timestamp": "13:39",
    "text": " Nish\u012btya chalya n\u0101mukha jikbh\u0101na sum\u0101na bh\u0101p\u0101"
  },
  {
    "offset_sec": 145.0,
    "vid_start_sec": 825.0,
    "timestamp": "13:45",
    "text": " Gejyandhanushka parthinavisv\u0101yob\u0101na v\u0101gumhuta"
  },
  {
    "offset_sec": 151.0,
    "vid_start_sec": 831.0,
    "timestamp": "13:51",
    "text": " Ane\u015bandasya s\u0101b\u0101 abh\u016br\u0101sya ni shangathe he"
  },
  {
    "offset_sec": 157.0,
    "vid_start_sec": 837.0,
    "timestamp": "13:57",
    "text": " Y\u0101tehe tenmidhu\u015btama haste bbubh\u0101t\u0113 dhanosthv\u0101na"
  },
  {
    "offset_sec": 165.0,
    "vid_start_sec": 845.0,
    "timestamp": "14:05",
    "text": " Nishv\u0101t\u0101stv\u0101 maryakshp\u0101d\u0101 paribh\u016bt\u0101 namaste"
  },
  {
    "offset_sec": 171.0,
    "vid_start_sec": 851.0,
    "timestamp": "14:11",
    "text": " Aztv\u0101dh\u016bt\u0101 g\u0101na t\u0101t\u0101 dhrithna v\u0113"
  },
  {
    "offset_sec": 176.0,
    "vid_start_sec": 856.0,
    "timestamp": "14:16",
    "text": " Ukh\u0101pbh\u0101bh\u0101t\u0113 namob\u0101 hukbh\u0101nta bha dhen bha dhen"
  },
  {
    "offset_sec": 182.0,
    "vid_start_sec": 862.0,
    "timestamp": "14:22",
    "text": " Parit\u0113 dhanbh\u0101dh\u0113ti dhasp\u0101na vrn\u0101ttu vishp\u0101d\u0101"
  },
  {
    "offset_sec": 188.0,
    "vid_start_sec": 868.0,
    "timestamp": "14:28",
    "text": " Athodai\u015budhisthav\u0101re asmanidhe hitam"
  },
  {
    "offset_sec": 194.0,
    "vid_start_sec": 874.0,
    "timestamp": "14:34",
    "text": " Chambh\u0101be n\u0101bh\u0101 namaste"
  },
  {
    "offset_sec": 198.0,
    "vid_start_sec": 878.0,
    "timestamp": "14:38",
    "text": " Aztv\u0101dh\u016bt\u0101 bha vandhisv\u0113sv\u0101dh\u0101 dhribh\u0101nta k\u0101gyatrik\u0101d"
  },
  {
    "offset_sec": 207.0,
    "vid_start_sec": 887.0,
    "timestamp": "14:47",
    "text": " K\u0101la j\u0101k\u0101la gnir\u016bt\u0101 dhani lakant\u0101 dhamrit"
  },
  {
    "offset_sec": 212.0,
    "vid_start_sec": 892.0,
    "timestamp": "14:52",
    "text": " Qunjadadya sarv\u0113sh p\u0101dya sa d\u0101c\u012bb\u0101dya srimanm\u0101dh\u0113 bha dhenam\u0101"
  },
  {
    "offset_sec": 220.0,
    "vid_start_sec": 900.0,
    "timestamp": "15:00",
    "text": " Namoh iranjab\u0101 havese n\u0101ndh\u0113 dhichan"
  },
  {
    "offset_sec": 225.0,
    "vid_start_sec": 905.0,
    "timestamp": "15:05",
    "text": " C\u0101patade da bodam bhukh\u0113bh\u0101t\u0113 khejhe"
  },
  {
    "offset_sec": 230.0,
    "vid_start_sec": 910.0,
    "timestamp": "15:10",
    "text": " J\u0101spach\u016bnam patade da bodam asas pindhar\u0101dh\u0113t"
  },
  {
    "offset_sec": 235.0,
    "vid_start_sec": 915.0,
    "timestamp": "15:15",
    "text": " D\u0101dh\u0113tbh\u0101t\u0113 patinam patade da bodam bhubh\u0101t\u0113"
  },
  {
    "offset_sec": 240.0,
    "vid_start_sec": 920.0,
    "timestamp": "15:20",
    "text": " Vrs\u0101dh\u0113 vibhy\u0101dh\u0113 n\u0101nam patade da bodam bh\u0101t\u0113 khejhe"
  },
  {
    "offset_sec": 246.0,
    "vid_start_sec": 926.0,
    "timestamp": "15:26",
    "text": " J\u0101dh\u016bbh\u0101 vithin\u0113 pusht\u0101nam patade da bodam bhubh\u0101t\u0113"
  },
  {
    "offset_sec": 252.0,
    "vid_start_sec": 932.0,
    "timestamp": "15:32",
    "text": " J\u0101k\u0101la gnir\u016bt\u0101 patade da bodam bhubh\u0101t\u0113"
  },
  {
    "offset_sec": 256.0,
    "vid_start_sec": 936.0,
    "timestamp": "15:36",
    "text": " Dhr\u0101dh\u0113tbh\u0101t\u0113 bide ksh\u0113t\u0101nam patade da bodam asas"
  },
  {
    "offset_sec": 261.0,
    "vid_start_sec": 941.0,
    "timestamp": "15:41",
    "text": " S\u016bt\u0101dh\u0113tbh\u0101t\u0113 dhichan"
  },
  {
    "offset_sec": 264.0,
    "vid_start_sec": 944.0,
    "timestamp": "15:44",
    "text": " D\u0101dh\u0113tbh\u0101t\u0113 da bodam bhurohit\u0101 just"
  },
  {
    "offset_sec": 268.0,
    "vid_start_sec": 948.0,
    "timestamp": "15:48",
    "text": " Tha patade vrk\u0101nam patade da bodam bhubh\u0101t\u0113"
  },
  {
    "offset_sec": 273.0,
    "vid_start_sec": 953.0,
    "timestamp": "15:53",
    "text": " J\u0101dh\u0113tbh\u0101t\u0113 da bodam bhubh\u0101t\u0113 khejhe"
  },
  {
    "offset_sec": 281.0,
    "vid_start_sec": 961.0,
    "timestamp": "16:01",
    "text": " J\u0101dh\u0113tbh\u0101t\u0113 da bodam bhubh\u0101t\u0113 khejhe"
  },
  {
    "offset_sec": 285.0,
    "vid_start_sec": 965.0,
    "timestamp": "16:05",
    "text": " J\u0101dh\u0113tbh\u0101t\u0113 khanda kert\u0113 patinam patade da bodam bhubh\u0101t\u0113"
  },
  {
    "offset_sec": 290.0,
    "vid_start_sec": 970.0,
    "timestamp": "16:10",
    "text": " Kri\u1e63na v\u012bt\u0101 dh\u0101v\u0101t\u0113 tp\u0101nam patade da bodam bh\u0101t\u0113"
  },
  {
    "offset_sec": 296.0,
    "vid_start_sec": 976.0,
    "timestamp": "16:16",
    "text": " N\u0101ma s\u0101h\u0101b\u0101 n\u0101gane viy\u0101dh\u012b n\u0101p"
  },
  {
    "offset_sec": 300.0,
    "vid_start_sec": 980.0,
    "timestamp": "16:20",
    "text": " Vy\u0101dh\u012b n\u0101p"
  },
  {
    "offset_sec": 301.0,
    "vid_start_sec": 981.0,
    "timestamp": "16:21",
    "text": " Patade da bodam bhubh\u0101t\u0113 khejhe"
  },
  {
    "offset_sec": 305.0,
    "vid_start_sec": 985.0,
    "timestamp": "16:25",
    "text": " J\u0101dh\u0113tbh\u0101t\u0113 khejhe"
  },
  {
    "offset_sec": 331.0,
    "vid_start_sec": 1011.0,
    "timestamp": "16:51",
    "text": " nampatadena mo na mo zimat dhyonak tancharad,"
  },
